# Server-only application configuration. Do not prefix any of these with NEXT_PUBLIC_.
ORION_UPSTREAM=http://orion:8000
ORION_AUTHORIZATION=

# Auth.js / NextAuth
SESSION_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional server-side role assignment by email. Comma-separated.
LAB_ANALYST_EMAILS=
LAB_ADMIN_EMAILS=

# nginx production boundary
AUTH_UPSTREAM=http://auth:8080
AUTH_REQUEST_DIRECTIVE=auth_request /_auth;
